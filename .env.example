# ---------------------------------------------------------------------------
# Pluto Advance 0.5 — example environment file
#
# Copy to ".env" and fill in real values. NEVER commit the real .env file.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# Preferred: store the API key in Windows Credential Manager via the app's
# Settings screen instead of a .env file. The .env path exists for developers.
# ---------------------------------------------------------------------------

# --- Claude API ---------------------------------------------------------
# Get a key from https://console.anthropic.com/ — it starts with "sk-ant-".
# Leave blank to be prompted on first run (recommended for end users).
ANTHROPIC_API_KEY=

# Model used for planning and chat. Override only if you know what you want.
PLUTO_MODEL=claude-sonnet-5-5

# Max tokens per model response.
PLUTO_MAX_TOKENS=4096

# --- Storage ------------------------------------------------------------
# Where the app keeps its database, logs and evidence.
# Leave blank to use the OS default:
#   Windows -> %LOCALAPPDATA%\PlutoAdvance
#   Linux   -> ~/.local/share/pluto-advance
PLUTO_DATA_DIR=

# --- Autonomy & safety --------------------------------------------------
# One of: observe | assisted | workflow | supervised
PLUTO_AUTONOMY_MODE=assisted

# Hard ceiling on steps the agent may run for a single task.
PLUTO_MAX_STEPS_PER_TASK=25

# Wall-clock budget for one task, in seconds.
PLUTO_TASK_TIMEOUT_SECONDS=900

# Per-tool execution timeout, in seconds.
PLUTO_TOOL_TIMEOUT_SECONDS=60

# --- Filesystem sandbox -------------------------------------------------
# Folders the agent may touch, separated by the OS path separator
# (";" on Windows, ":" on Linux). Anything outside these is refused.
# Example (Windows): C:\Users\me\Documents\PlutoWorkspace;C:\Users\me\Downloads
PLUTO_ALLOWED_FOLDERS=

# --- Browser automation -------------------------------------------------
# Run the browser visibly. Keep "true" — hidden automation is against policy.
PLUTO_BROWSER_HEADLESS=false

# Domains the browser tool may visit, comma separated. Empty = none allowed.
PLUTO_ALLOWED_DOMAINS=

# --- Logging ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
PLUTO_LOG_LEVEL=INFO

# Days to keep audit records and logs before pruning.
PLUTO_RETENTION_DAYS=90

# --- Voice (optional) ---------------------------------------------------
# Speech provider: none | openai | azure | google
PLUTO_SPEECH_PROVIDER=none
PLUTO_SPEECH_API_KEY=
# Recognition language hint: hi-IN | en-IN | en-US | auto
PLUTO_SPEECH_LANGUAGE=auto
